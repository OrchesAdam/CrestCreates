<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CrestCreates.Web.Legacy</RootNamespace>
    <AssemblyName>CrestCreates.Web.Legacy</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legacy activation is an explicit opt-in package; it consumes the legacy runtime and the
         shared formal contracts, never the other way around. -->
    <ProjectReference Include="../../Framework/Api/CrestCreates.DynamicApi.Legacy/CrestCreates.DynamicApi.Legacy.csproj" />
  </ItemGroup>

</Project>
