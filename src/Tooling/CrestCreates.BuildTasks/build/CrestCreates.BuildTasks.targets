<Project>
  <PropertyGroup>
    <CrestCreatesBuildTasksAssembly Condition="'$(CrestCreatesBuildTasksAssembly)' == ''">$(MSBuildThisFileDirectory)net10.0/CrestCreates.BuildTasks.dll</CrestCreatesBuildTasksAssembly>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)CrestCreates.Modules.props" />
  <Target Name="CleanModuleManifests" AfterTargets="Clean" DependsOnTargets="InitializeCrestCreatesBuildTaskPaths">
    <Delete Files="$(ModuleManifestOutputPath);$(AggregatedModuleManifestPath);$(AggregatedModuleCodePath);$(EntityPermissionsManifestOutputPath)" />
  </Target>
</Project>
