<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  
  <!-- 
    CrestCreates Build Tasks Targets File
    This file contains the MSBuild targets for module discovery
  -->
  
  <!-- Import the build tasks assembly -->
  <UsingTask TaskName="CrestCreates.BuildTasks.ScanModulesFromSource" AssemblyFile="$(MSBuildThisFileDirectory)net10.0\CrestCreates.BuildTasks.dll" />
  <UsingTask TaskName="CrestCreates.BuildTasks.CollectModuleManifests" AssemblyFile="$(MSBuildThisFileDirectory)net10.0\CrestCreates.BuildTasks.dll" />
  <UsingTask TaskName="CrestCreates.BuildTasks.GenerateAggregatedModuleCode" AssemblyFile="$(MSBuildThisFileDirectory)net10.0\CrestCreates.BuildTasks.dll" />
  <UsingTask TaskName="CrestCreates.BuildTasks.ScanEntityPermissions" AssemblyFile="$(MSBuildThisFileDirectory)net10.0\CrestCreates.BuildTasks.dll" />
  <PropertyGroup>
    <EnableModuleManifestGeneration Condition="'$(EnableModuleManifestGeneration)' == ''">true</EnableModuleManifestGeneration>
    <EnableEntityPermissionsScan Condition="'$(EnableEntityPermissionsScan)' == ''">true</EnableEntityPermissionsScan>
  </PropertyGroup>

  <Target Name="InitializeCrestCreatesBuildTaskPaths"
          BeforeTargets="GenerateModuleManifest;CollectAndGenerateAggregatedModules;ScanEntityPermissions;CleanModuleManifests">
    <PropertyGroup>
      <ModuleManifestOutputPath Condition="'$(ModuleManifestOutputPath)' == ''">$(IntermediateOutputPath)ModuleManifest.json</ModuleManifestOutputPath>
      <AggregatedModuleManifestPath Condition="'$(AggregatedModuleManifestPath)' == ''">$(IntermediateOutputPath)AggregatedModuleManifest.json</AggregatedModuleManifestPath>
      <CrestCreatesModuleAutoInitializerFile Condition="'$(CrestCreatesModuleAutoInitializerFile)' == ''">$(IntermediateOutputPath)ModuleAutoInitializer.g.cs</CrestCreatesModuleAutoInitializerFile>
      <AggregatedModuleCodePath Condition="'$(AggregatedModuleCodePath)' == ''">$(CrestCreatesModuleAutoInitializerFile)</AggregatedModuleCodePath>
      <EntityPermissionsManifestOutputPath Condition="'$(EntityPermissionsManifestOutputPath)' == ''">$(IntermediateOutputPath)EntityPermissionsManifest.json</EntityPermissionsManifestOutputPath>
    </PropertyGroup>
  </Target>
  <!-- 
    Target: GenerateModuleManifest
    Description: Scans source files for [Module] attributes and generates a manifest
    Runs: Before CoreCompile through CollectAndGenerateAggregatedModules dependency
  -->
  <Target Name="GenerateModuleManifest"
          Condition="'$(EnableModuleManifestGeneration)' == 'true'">
    
    <PropertyGroup>
      <_ModuleSourceFiles>@(Compile->'%(FullPath)')</_ModuleSourceFiles>
    </PropertyGroup>
    
    <ScanModulesFromSource
      SourceFiles="$(_ModuleSourceFiles)"
      OutputPath="$(ModuleManifestOutputPath)" />
    
    <Message Text="[CrestCreates] Generated module manifest: $(ModuleManifestOutputPath)" Importance="high" />
  </Target>
  
  <!-- 
    Target: CollectAndGenerateAggregatedModules
    Description: Collects modules from referenced projects and generates registration code
    Runs: Before CoreCompile
  -->
  <Target Name="CollectAndGenerateAggregatedModules"
          DependsOnTargets="GenerateModuleManifest"
          BeforeTargets="CoreCompile"
          Condition="'$(EnableModuleManifestGeneration)' == 'true'">
    
    <ItemGroup>
      <_ModuleManifestFiles Include="$(ModuleManifestOutputPath)" />
    </ItemGroup>
    
    <Message Text="[CrestCreates] Looking for module manifests in referenced projects..." Importance="high" />
    
    <ItemGroup>
      <_ReferencedProjectPaths Include="@(ProjectReference->'%(FullPath)')" />
    </ItemGroup>
    
    <CollectModuleManifests
      ModuleManifestFiles="@(_ModuleManifestFiles)"
      ReferencedProjectPaths="@(_ReferencedProjectPaths)"
      OutputPath="$(AggregatedModuleManifestPath)" />
    
    <Message Text="[CrestCreates] Collected modules to: $(AggregatedModuleManifestPath)" Importance="high" />
    
    <GenerateAggregatedModuleCode
      ModuleManifestFile="$(AggregatedModuleManifestPath)"
      OutputPath="$(AggregatedModuleCodePath)"
      Namespace="CrestCreates.Modularity" />
    
    <Message Text="[CrestCreates] Generated module registration code: $(AggregatedModuleCodePath)" Importance="high" />
    
    <!-- Include the generated file before CoreCompile so it participates in the current compilation. -->
    <ItemGroup Condition="Exists('$(AggregatedModuleCodePath)')">
      <Compile Include="$(AggregatedModuleCodePath)"
               Link="ModuleAutoInitializer.g.cs"
               Visible="false" />
    </ItemGroup>
  </Target>
  
  <!-- 
    Target: CleanModuleManifests
    Description: Cleans up generated module manifests during clean build
    Runs: During Clean
  -->
  <Target Name="CleanModuleManifests" AfterTargets="Clean">
    <Delete Files="$(ModuleManifestOutputPath)" Condition="Exists('$(ModuleManifestOutputPath)')" />
    <Delete Files="$(AggregatedModuleManifestPath)" Condition="Exists('$(AggregatedModuleManifestPath)')" />
    <Delete Files="$(AggregatedModuleCodePath)" Condition="Exists('$(AggregatedModuleCodePath)')" />
    <Delete Files="$(EntityPermissionsManifestOutputPath)" Condition="Exists('$(EntityPermissionsManifestOutputPath)')" />
    <Message Text="[CrestCreates] Cleaned module manifests" Importance="normal" />
  </Target>

  <Target Name="ScanEntityPermissions"
          AfterTargets="Build"
          Condition="'$(EnableEntityPermissionsScan)' == 'true'">

    <ItemGroup>
      <_EntityPermissionSourceFiles Include="@(Compile->'%(FullPath)')" />
      <_EntityPermissionSourceFiles Include="$(CompilerGeneratedFilesOutputPath)\**\*Permissions.g.cs" Condition="'$(CompilerGeneratedFilesOutputPath)' != ''" />
      <_EntityPermissionSourceFiles Include="$(IntermediateOutputPath)generated\**\*Permissions.g.cs" />
    </ItemGroup>

    <ScanEntityPermissions
      SourceFiles="@(_EntityPermissionSourceFiles)"
      OutputPath="$(EntityPermissionsManifestOutputPath)" />

    <Copy SourceFiles="$(EntityPermissionsManifestOutputPath)"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('$(EntityPermissionsManifestOutputPath)')" />

    <ItemGroup Condition="Exists('$(EntityPermissionsManifestOutputPath)')">
      <Content Include="$(EntityPermissionsManifestOutputPath)"
               Link="EntityPermissionsManifest.json"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Message Text="[CrestCreates] Generated entity permissions manifest: $(EntityPermissionsManifestOutputPath)" Importance="high" />
  </Target>
  
</Project>
