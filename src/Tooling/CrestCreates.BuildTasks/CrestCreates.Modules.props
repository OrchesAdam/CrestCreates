<Project>
  <PropertyGroup>
    <CrestCreatesBuildTasksAssembly Condition="'$(CrestCreatesBuildTasksAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)bin/$(Configuration)/net10.0/CrestCreates.BuildTasks.dll')">$(MSBuildThisFileDirectory)bin/$(Configuration)/net10.0/CrestCreates.BuildTasks.dll</CrestCreatesBuildTasksAssembly>
    <CrestCreatesBuildTasksAssembly Condition="'$(CrestCreatesBuildTasksAssembly)' == ''">$(MSBuildThisFileDirectory)bin/Debug/net10.0/CrestCreates.BuildTasks.dll</CrestCreatesBuildTasksAssembly>
  </PropertyGroup>
  <UsingTask TaskName="CrestCreates.BuildTasks.ScanModulesFromSource" AssemblyFile="$(CrestCreatesBuildTasksAssembly)" />
  <UsingTask TaskName="CrestCreates.BuildTasks.CollectModuleManifests" AssemblyFile="$(CrestCreatesBuildTasksAssembly)" />
  <UsingTask TaskName="CrestCreates.BuildTasks.GenerateAggregatedModuleCode" AssemblyFile="$(CrestCreatesBuildTasksAssembly)" />
  <UsingTask TaskName="CrestCreates.BuildTasks.ScanEntityPermissions" AssemblyFile="$(CrestCreatesBuildTasksAssembly)" />

  <PropertyGroup>
    <EnableModuleManifestGeneration Condition="'$(EnableModuleManifestGeneration)' == ''">true</EnableModuleManifestGeneration>
    <EnableEntityPermissionsScan Condition="'$(EnableEntityPermissionsScan)' == ''">true</EnableEntityPermissionsScan>
  </PropertyGroup>

  <Target Name="InitializeCrestCreatesBuildTaskPaths"
          BeforeTargets="CleanStaleModuleAutoInitializer;GenerateModuleManifest;CollectAndGenerateAggregatedModules;GetCrestCreatesModuleManifestPath;ScanEntityPermissions">
    <PropertyGroup>
      <ModuleManifestOutputPath Condition="'$(ModuleManifestOutputPath)' == ''">$(IntermediateOutputPath)ModuleManifest.json</ModuleManifestOutputPath>
      <AggregatedModuleManifestPath Condition="'$(AggregatedModuleManifestPath)' == ''">$(IntermediateOutputPath)AggregatedModuleManifest.json</AggregatedModuleManifestPath>
      <CrestCreatesModuleAutoInitializerFile Condition="'$(CrestCreatesModuleAutoInitializerFile)' == ''">$(IntermediateOutputPath)ModuleAutoInitializer.g.cs</CrestCreatesModuleAutoInitializerFile>
      <AggregatedModuleCodePath Condition="'$(AggregatedModuleCodePath)' == ''">$(CrestCreatesModuleAutoInitializerFile)</AggregatedModuleCodePath>
      <EntityPermissionsManifestOutputPath Condition="'$(EntityPermissionsManifestOutputPath)' == ''">$(IntermediateOutputPath)EntityPermissionsManifest.json</EntityPermissionsManifestOutputPath>
    </PropertyGroup>
  </Target>

  <!-- Clean stale generated files from previous path migrations -->
  <Target Name="CleanStaleModuleAutoInitializer"
          BeforeTargets="GenerateModuleManifest"
          Condition="'$(EnableModuleManifestGeneration)' == 'true'">
    <Delete Files="$(MSBuildProjectDirectory)\CrestCreates.Generated\ModuleAutoInitializer.g.cs"
            Condition="Exists('$(MSBuildProjectDirectory)\CrestCreates.Generated\ModuleAutoInitializer.g.cs')" />
  </Target>

  <Target Name="GenerateModuleManifest"
          Condition="'$(EnableModuleManifestGeneration)' == 'true'">

    <PropertyGroup>
      <_ModuleSourceFiles>@(Compile->'%(FullPath)')</_ModuleSourceFiles>
    </PropertyGroup>

    <ScanModulesFromSource
      SourceFiles="$(_ModuleSourceFiles)"
      DefineConstants="$(DefineConstants)"
      OutputPath="$(ModuleManifestOutputPath)" />

    <Message Text="Generated module manifest at $(ModuleManifestOutputPath)" Importance="high" />
  </Target>

  <!-- Only projects importing this contract contribute required manifest paths. Ordinary
       references have no such target and contribute nothing. Recurse for transitive modules. -->
  <Target Name="GetCrestCreatesModuleManifestPath"
          DependsOnTargets="GenerateModuleManifest;ResolveProjectReferences"
          Returns="@(_CrestModuleManifestPaths)"
          Condition="'$(EnableModuleManifestGeneration)' == 'true'">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="GetCrestCreatesModuleManifestPath"
             Properties="Configuration=$(Configuration);%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences);RuntimeIdentifier;SelfContained"
             SkipNonexistentTargets="true" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_CrestModuleManifestPaths" />
    </MSBuild>
    <ItemGroup>
      <_CrestModuleManifestPaths Include="$([System.IO.Path]::GetFullPath('$(ModuleManifestOutputPath)', '$(MSBuildProjectDirectory)'))" />
    </ItemGroup>
  </Target>

  <Target Name="CollectAndGenerateAggregatedModules"
          DependsOnTargets="GenerateModuleManifest;ResolveProjectReferences"
          BeforeTargets="CoreCompile"
          Condition="'$(EnableModuleManifestGeneration)' == 'true'">

    <ItemGroup>
      <_ModuleManifestFiles Include="$(ModuleManifestOutputPath)" />
    </ItemGroup>

    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="GetCrestCreatesModuleManifestPath"
             Properties="Configuration=$(Configuration);%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences);RuntimeIdentifier;SelfContained"
             SkipNonexistentTargets="true" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_ReferencedModuleManifestFiles" />
    </MSBuild>

    <CollectModuleManifests
      ModuleManifestFiles="@(_ModuleManifestFiles)"
      ReferencedModuleManifestFiles="@(_ReferencedModuleManifestFiles)"
      OutputPath="$(AggregatedModuleManifestPath)" />

    <GenerateAggregatedModuleCode
      ModuleManifestFile="$(AggregatedModuleManifestPath)"
      OutputPath="$(AggregatedModuleCodePath)"
      Namespace="CrestCreates.Modularity" />

    <Message Text="Generated aggregated module code at $(AggregatedModuleCodePath)" Importance="high" />

    <!-- Include the generated file before CoreCompile so it participates in the current compilation. -->
    <ItemGroup Condition="Exists('$(AggregatedModuleCodePath)')">
      <Compile Remove="$(AggregatedModuleCodePath)" />
      <Compile Include="$(AggregatedModuleCodePath)"
               Link="ModuleAutoInitializer.g.cs"
               Visible="false" />
    </ItemGroup>
  </Target>

  <Target Name="ScanEntityPermissions"
          AfterTargets="Build"
          Condition="'$(EnableEntityPermissionsScan)' == 'true'">

    <ItemGroup>
      <_EntityPermissionSourceFiles Include="@(Compile->'%(FullPath)')" />
      <_EntityPermissionSourceFiles Include="$(CompilerGeneratedFilesOutputPath)\**\*Permissions.g.cs" Condition="'$(CompilerGeneratedFilesOutputPath)' != ''" />
      <_EntityPermissionSourceFiles Include="$(IntermediateOutputPath)generated\**\*Permissions.g.cs" />
    </ItemGroup>

    <ScanEntityPermissions
      SourceFiles="@(_EntityPermissionSourceFiles)"
      OutputPath="$(EntityPermissionsManifestOutputPath)" />

    <Copy SourceFiles="$(EntityPermissionsManifestOutputPath)"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('$(EntityPermissionsManifestOutputPath)')" />

    <ItemGroup Condition="Exists('$(EntityPermissionsManifestOutputPath)')">
      <Content Include="$(EntityPermissionsManifestOutputPath)"
               Link="EntityPermissionsManifest.json"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Message Text="Generated entity permissions manifest at $(EntityPermissionsManifestOutputPath)" Importance="high" />
  </Target>

</Project>
