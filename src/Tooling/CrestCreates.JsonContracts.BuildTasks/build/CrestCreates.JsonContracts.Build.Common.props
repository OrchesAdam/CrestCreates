<Project>
  <PropertyGroup>
    <CrestCreatesJsonContractGenerationEnabled Condition="'$(CrestCreatesJsonContractGenerationEnabled)' == ''">true</CrestCreatesJsonContractGenerationEnabled>
    <CrestCreatesJsonContractManifestAccessibility Condition="'$(CrestCreatesJsonContractManifestAccessibility)' == ''">Internal</CrestCreatesJsonContractManifestAccessibility>
    <CrestCreatesJsonContractGenerationDependsOn Condition="'$(CrestCreatesJsonContractGenerationDependsOn)' == ''"></CrestCreatesJsonContractGenerationDependsOn>
    <!-- #128 S2: the CRUD precompile chain is explicitly ordered ahead of JSON input collection, so
         JsonContracts and the official STJ generator consume the materialized surface in one build. -->
    <CrestCreatesCrudPrecompileEnabled Condition="'$(CrestCreatesCrudPrecompileEnabled)' == ''">$(CrestCreatesJsonContractGenerationEnabled)</CrestCreatesCrudPrecompileEnabled>
    <CrestCreatesCodeGenerationIsDisabled Condition="'$(CrestCreatesCodeGeneration)' == 'false'">true</CrestCreatesCodeGenerationIsDisabled>
    <CrestCreatesCodeGenerationIsDisabled Condition="'$(CrestCreatesCodeGenerationIsDisabled)' == ''">false</CrestCreatesCodeGenerationIsDisabled>
    <CrestCreatesJsonContractGenerationDependsOn>$(CrestCreatesJsonContractGenerationDependsOn);PrepareCrestCrudInputs;GenerateCrestCrudSurface;IncludeCrestCrudArtifacts</CrestCreatesJsonContractGenerationDependsOn>
    <CrestCreatesJsonContractsTaskSemanticVersion Condition="'$(CrestCreatesJsonContractsTaskSemanticVersion)' == ''">1.0.0</CrestCreatesJsonContractsTaskSemanticVersion>
    <!-- Marker consumed by the LocalEvent source generator (via CompilerVisibleProperty) to verify
         that this project imports the JSON contract toolchain before declaring replayable events. -->
    <CrestCreatesLocalEventJsonContracts>true</CrestCreatesLocalEventJsonContracts>
    <!-- Marker consumed by the EventDescriptor source generator (via CompilerVisibleProperty) to verify
         that this project imports the JSON contract toolchain before declaring Integration events. -->
    <CrestCreatesEventJsonContracts>true</CrestCreatesEventJsonContracts>
    <!-- Marker consumed by the CRUD generator: a formal [GenerateCrudService] declaration without the
         CRUD precompile + JSON toolchain assembled is a deterministic build error, never a legacy
         fallback. -->
    <CrestCreatesCrudJsonToolchain Condition="'$(CrestCreatesCrudPrecompileEnabled)' == 'true'">true</CrestCreatesCrudJsonToolchain>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="CrestCreatesCrudJsonToolchain" />
    <CompilerVisibleProperty Include="CrestCreatesLocalEventJsonContracts" />
    <CompilerVisibleProperty Include="CrestCreatesEventJsonContracts" />
  </ItemGroup>
</Project>
