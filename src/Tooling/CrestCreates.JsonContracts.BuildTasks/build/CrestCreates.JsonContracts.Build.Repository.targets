<Project>
  <PropertyGroup>
    <_CrestCreatesJsonContractsRepositoryTargetsImported>true</_CrestCreatesJsonContractsRepositoryTargetsImported>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_CrestCreatesJsonContractsPackageTargetsImported)' == 'true'">
    <_CrestCreatesJsonContractsImportConflict>true</_CrestCreatesJsonContractsImportConflict>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)CrestCreates.JsonContracts.Build.Common.targets"
          Condition="'$(_CrestCreatesJsonContractsTargetsImported)' != 'true'" />
  <PropertyGroup>
    <_CrestCreatesJsonContractsTargetsImported>true</_CrestCreatesJsonContractsTargetsImported>
  </PropertyGroup>
</Project>
