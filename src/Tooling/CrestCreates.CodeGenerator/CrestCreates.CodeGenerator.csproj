<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>CrestCreates.CodeGenerator</RootNamespace>
    <AssemblyName>CrestCreates.CodeGenerator</AssemblyName>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <!-- #128 S2: the CRUD model/emitters are one implementation, source-linked into the analyzer and
         the build-time tool so field rules, routes and identity can never drift apart. -->
    <Compile Include="..\CrestCreates.CrudGeneration\*.cs" Link="CrudGeneration\%(Filename)%(Extension)" />
    <!-- #129 S2: source-linked hand-written HTTP projection model, shared by the analyzer and the precompile tool. -->
    <Compile Include="..\CrestCreates.HttpProjectionGeneration\*.cs" Link="HttpProjectionGeneration\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
