<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CrestCreates.DynamicApi</RootNamespace>
    <AssemblyName>CrestCreates.DynamicApi.Legacy</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- One-way compatibility dependency: the legacy surface consumes the shared formal contracts,
         never the other way around. -->
    <ProjectReference Include="../CrestCreates.DynamicApi/CrestCreates.DynamicApi.csproj" />
  </ItemGroup>

</Project>
