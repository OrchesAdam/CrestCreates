    <ProjectReference Include="../../../Metadata/CrestCreates.Schema.Abstractions/CrestCreates.Schema.Abstractions.csproj" />
    <ProjectReference Include="../../../Tooling/CrestCreates.CodeGenerator/CrestCreates.CodeGenerator.csproj"
