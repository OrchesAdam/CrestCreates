      IMPORTANT: ControlPlane.Abstractions must NOT expose these concrete types in its public API surface.
      This is enforced by the boundary test ControlPlaneAbstractionsPublicApiGuardTests.
    -->
    <ProjectReference Include="../../../Metadata/Draft/CrestCreates.DescriptorDraft/CrestCreates.DescriptorDraft.csproj" />
    <ProjectReference Include="../../Capability/CrestCreates.Capability.Abstractions/CrestCreates.Capability.Abstractions.csproj" />
