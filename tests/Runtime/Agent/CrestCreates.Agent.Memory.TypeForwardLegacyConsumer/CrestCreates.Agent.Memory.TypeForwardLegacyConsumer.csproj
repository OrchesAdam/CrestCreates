<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TypeForwardLegacyConsumer</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      This consumer references the PRE-MIGRATION contract replica
      (TypeForwardLegacyContract), NOT the current forwarding assembly.
      The LegacyContract project has the same assembly name and type definitions
      as the original Tools.Abstractions, but WITHOUT [assembly: TypeForwardedTo].
      The consumer DLL encodes type references to the old assembly identity.
      At runtime, the current forwarding assembly resolves them via TypeForwardedTo.
    -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CrestCreates.Agent.Memory.TypeForwardLegacyContract\CrestCreates.Agent.Memory.TypeForwardLegacyContract.csproj" />
  </ItemGroup>
</Project>
