<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CrestCreates.Core.AotHost</AssemblyName>
    <RootNamespace>CrestCreates.Core.AotHost</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The fixture proves the Core contracts survive the same reflection-free contract as consumers. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Core/CrestCreates.Core.Abstractions/CrestCreates.Core.Abstractions.csproj" />
    <ProjectReference Include="../../../src/Core/CrestCreates.Core/CrestCreates.Core.csproj" />
  </ItemGroup>

</Project>
