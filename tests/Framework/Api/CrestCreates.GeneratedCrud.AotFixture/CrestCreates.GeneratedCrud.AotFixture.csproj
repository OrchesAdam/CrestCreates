<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- #128 S4 fixture contract: the same compiler-level switch the Feature project carries, so a
         reflective fallback can never silently satisfy the CRUD JSON surface on the host either. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- #128 S4 native gate: the same AOT contract the proven CapabilityEndpoint / LocalEvent hosts
         carry. The gate publishes with -p:CrestCreatesPublishMode=aot (Directory.Build.Aot.props
         selects NativeAOT from that mode). IL codes are NOT promoted to errors here: this fixture's
         publish graph includes pre-existing framework projects (Aop, Application.Contracts) whose
         trim warnings are their own subsystem's scope; the gate harness instead asserts that no
         IL2026/IL3050 diagnostic is attributed to this fixture's own projects. -->
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The fixture's only authored CRUD input is the Feature's [GenerateCrudService] declaration;
         this host consumes its generated activation (AddGeneratedCrud) like an ordinary consumer. -->
    <ProjectReference Include="../CrestCreates.GeneratedCrud.AotFixture.Feature/CrestCreates.GeneratedCrud.AotFixture.Feature.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime dependencies: the same host shape the proven CapabilityEndpoint.AotFixture and
         CompatibilityProjection.E2E hosts consume. -->
    <ProjectReference Include="../../../../src/Framework/Api/CrestCreates.DynamicApi/CrestCreates.DynamicApi.csproj" />
    <ProjectReference Include="../../../../src/Framework/Api/CrestCreates.DynamicApi.Abstractions/CrestCreates.DynamicApi.Abstractions.csproj" />
    <ProjectReference Include="../../../../src/Runtime/Audit/CrestCreates.Accountability/CrestCreates.Accountability.csproj" />
    <ProjectReference Include="../../../../src/Runtime/Capability/CrestCreates.Capability/CrestCreates.Capability.csproj" />
    <ProjectReference Include="../../../../src/Runtime/Capability/CrestCreates.Capability.Abstractions/CrestCreates.Capability.Abstractions.csproj" />
    <ProjectReference Include="../../../../src/Metadata/CrestCreates.Metadata/CrestCreates.Metadata.csproj" />
    <ProjectReference Include="../../../../src/Metadata/CrestCreates.Metadata.Abstractions/CrestCreates.Metadata.Abstractions.csproj" />
    <!-- The DI seams the generated WidgetAppService injects. -->
    <ProjectReference Include="../../../../src/Framework/Ddd/CrestCreates.Domain/CrestCreates.Domain.csproj" />
    <ProjectReference Include="../../../../src/Framework/Ddd/CrestCreates.Domain.Shared/CrestCreates.Domain.Shared.csproj" />
    <ProjectReference Include="../../../../src/Framework/Infrastructure/CrestCreates.Authorization.Abstractions/CrestCreates.Authorization.Abstractions.csproj" />
    <ProjectReference Include="../../../../src/Framework/Infrastructure/CrestCreates.MultiTenancy.Abstract/CrestCreates.MultiTenancy.Abstract.csproj" />
    <ProjectReference Include="../../../../src/Framework/Modularity/CrestCreates.Modularity/CrestCreates.Modularity.csproj" />
    <ProjectReference Include="../../../../src/Persistence/CrestCreates.Data.Abstractions/CrestCreates.Data.Abstractions.csproj" />
  </ItemGroup>

</Project>
