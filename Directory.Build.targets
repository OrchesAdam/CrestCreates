<Project>
  <!-- 测试项目禁用 AoT（Moq/Castle.DynamicProxy 需要运行时代码生成） -->
  <PropertyGroup Condition="$(IsTestProject) == 'true'">
    <PublishAot>false</PublishAot>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>
  <!-- 修改SourceGenerator输出的目录 -->
  <PropertyGroup  Condition="'$(EnforceExtendedAnalyzerRules)' != 'true'">
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(IntermediateOutputPath)\source-generators</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
</Project>
