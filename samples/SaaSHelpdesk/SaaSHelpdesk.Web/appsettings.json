{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=saashelpdesk;Username=crest;Password=crest123"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CrestLogging": {
    "MinimumLevel": "Information",
    "EnableConsole": true,
    "EnableFile": true,
    "FilePath": "logs/saashelpdesk-.txt",
    "Overrides": {
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AuditLogging": {
    "IsEnabled": true,
    "IsEnabledForGetRequests": false,
    "IncludeRequestBody": false,
    "IncludeResponseBody": false
  },
  "Jwt": {
    "SecretKey": "SaaSHelpdeskSampleSecretKey123!",
    "Issuer": "SaaSHelpdesk",
    "Audience": "SaaSHelpdesk",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Identity": {
    "MinPasswordLength": 8,
    "RequireDigit": true,
    "RequireLowercase": true,
    "RequireUppercase": true,
    "RequireNonAlphanumeric": false,
    "MaxAccessFailedCount": 5,
    "LockoutMinutes": 15
  },
  "SeedIdentity": {
    "TenantId": "host",
    "RoleName": "Administrators",
    "UserName": "admin",
    "Email": "admin@helpdesk.local",
    "Password": "Admin123!"
  },
  "AllowedHosts": "*"
}
