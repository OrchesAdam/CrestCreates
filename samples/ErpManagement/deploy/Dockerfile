# ErpManagement runtime image.
#
# Build strategy (see deploy/README.md): the frontend and backend are pre-built on the
# host by deploy/build.sh, then packaged here onto the official ASP.NET runtime image.
# This avoids requiring Docker Hub (node/sdk images) which is unreachable in the target
# environment; only mcr.microsoft.com is needed and it is reachable.
#
# OpenIddict's token endpoint requires HTTPS, so the app terminates TLS with a localhost
# development certificate generated by build.sh (erp-dev.pfx). This is a sample-only dev
# certificate, not a production secret.
FROM mcr.microsoft.com/dotnet/aspnet:10.0

WORKDIR /app

COPY publish/ ./
COPY erp-dev.pfx /https/erp-dev.pfx
COPY entrypoint.sh /entrypoint.sh

ENV ASPNETCORE_ENVIRONMENT=Development \
    ASPNETCORE_URLS=https://+:8443 \
    Kestrel__Certificates__Default__Path=/https/erp-dev.pfx \
    Kestrel__Certificates__Default__Password=erp-dev-cert

EXPOSE 8443

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]