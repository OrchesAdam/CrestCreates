{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=erpmanagement;Username=crest;Password=crest"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CrestLogging": {
    "MinimumLevel": "Information",
    "EnableConsole": true,
    "EnableFile": true,
    "FilePath": "logs/erpmanagement-.txt",
    "Overrides": {
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AuditLogging": {
    "IsEnabled": true,
    "IsEnabledForGetRequests": false,
    "IncludeRequestBody": false,
    "IncludeResponseBody": false
  },
  "Jwt": {
    "SecretKey": "ErpManagement.Sample.Development.Signing.Key.2026",
    "Issuer": "ErpManagement",
    "Audience": "ErpManagement",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "OpenIddict": {
    "EnablePasswordFlow": true,
    "EnableRefreshTokenFlow": true,
    "EnableClientCredentialsFlow": true
  },
  "Identity": {
    "MinPasswordLength": 8,
    "RequireDigit": true,
    "RequireLowercase": true,
    "RequireUppercase": true,
    "RequireNonAlphanumeric": false,
    "MaxAccessFailedCount": 5,
    "LockoutMinutes": 15
  },
  "SeedIdentity": {
    "TenantId": "host",
    "RoleName": "Administrators",
    "UserName": "admin",
    "Email": "admin@erp.local",
    "Password": "ErpDemo#2026"
  },
  "Integration": {
    "Clients": {
      "Mes": { "ApiKey": "mes-dev-key", "TenantId": "host" },
      "Crm": { "ApiKey": "crm-dev-key", "TenantId": "host" }
    }
  },
  "AllowedHosts": "*",
  "Erp": {
    "Runtime": {
      "Schema": "crest_erp_runtime"
    }
  }
}