<Project>
  <!-- Trim 发布配置（仅适用于 net10.0+ 项目，排除 netstandard2.0 的 CodeGenerator） -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'CrestCreates.CodeGenerator'">
    <!-- 默认目标是 Trim 发布，不默认启用 NativeAOT。NativeAOT 需要显式传入 -p:CrestCreatesPublishMode=aot。 -->
    <CrestCreatesPublishMode Condition="'$(CrestCreatesPublishMode)' == ''">trim</CrestCreatesPublishMode>
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <!-- 优化配置 -->
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- 运行时标识符 -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'CrestCreates.CodeGenerator' and '$(CrestCreatesPublishMode)' == 'trim'">
    <PublishTrimmed>true</PublishTrimmed>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'CrestCreates.CodeGenerator' and '$(CrestCreatesPublishMode)' == 'aot'">
    <PublishTrimmed>true</PublishTrimmed>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'CrestCreates.CodeGenerator'">
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <!-- EF Core NativeAOT 拦截器，仅在显式 AOT 发布时启用。 -->
  <PropertyGroup Condition="'$(CrestCreatesPublishMode)' == 'aot'">
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsNamespaces>
  </PropertyGroup>

  <!-- 全局 Source Generator (Analyzer) 引用 -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\Tooling\CrestCreates.CodeGenerator\CrestCreates.CodeGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      Condition="$(MSBuildProjectName) != 'CrestCreates.CodeGenerator' and '$(CrestCreatesCodeGeneration)' != 'false'" />
  </ItemGroup>

  <!-- 全局 ModuleDiagnostics 引用（排除 ModuleDiagnostics 自身和 Modularity 以避免循环依赖） -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\Framework\Modules\CrestCreates.ModuleDiagnostics\CrestCreates.ModuleDiagnostics.csproj"
                      Condition="$(MSBuildProjectName) != 'CrestCreates.ModuleDiagnostics' and $(MSBuildProjectName) != 'CrestCreates.Modularity' and '$(TargetFramework)' != 'netstandard2.0'" />
  </ItemGroup>

</Project>
